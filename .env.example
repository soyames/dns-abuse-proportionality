# Copy to .env and replace both passwords with unique values.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=dns_abuse_audit
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=replace-with-another-long-random-password
# Optional: obtain an Auth-Key from https://auth.abuse.ch/ to enable URLhaus.
URLHAUS_AUTH_KEY=
